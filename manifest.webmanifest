{
  "id": "/",
  "name": "Grox Wallet",
  "short_name": "Grox",
  "description": "Track spending, budgets, and goals privately. Your data stays on your device.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "orientation": "portrait",
  "background_color": "#010805",
  "theme_color": "#04452a",
  "dir": "ltr",
  "lang": "en",
  "categories": ["finance", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Cards",
      "short_name": "Cards",
      "description": "View and manage cards",
      "url": "/?view=cards",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Activity",
      "short_name": "Activity",
      "description": "View recent transactions",
      "url": "/?view=activity",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}